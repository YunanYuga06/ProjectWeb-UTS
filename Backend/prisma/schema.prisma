// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // Tambahkan baris output ini:
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  username          String    @unique
  hashedPassword    String
  salt              String?
  encryptedFullName String?
  encryptedEmail    String?
  bookings          Booking[]
}

model Booking {
  id                    Int       @id @default(autoincrement())
  userId                Int
  user                  User      @relation(fields: [userId], references: [id])
  tourName              String // Ini bisa diganti dengan relasi ke Service.id
  bookingDate           String
  encryptedPaymentDetails String?
  serviceId             Int?      // Opsional: Foreign Key ke Service.id
  service               Service?  @relation(fields: [serviceId], references: [id])
}

model Destination {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  shortDescription String
  longDescription String
  imageUrl        String
  cardImageUrl    String
  location        String
  temperatureRange String?
  altitude        String?
  categories      String        // Prisma support for string arrays with SQLite if provider is set correctly, or use JSON
  features        String?
  galleryImages   GalleryImage[]
  services        Service[]
  testimonials    Testimonial[] // Jika testimoni khusus untuk destinasi
}

model Testimonial {
  id              Int       @id @default(autoincrement())
  quoteText       String
  authorName      String
  authorRole      String
  destinationId   Int?
  destination     Destination? @relation(fields: [destinationId], references: [id])
}

model GalleryImage {
  id              Int       @id @default(autoincrement())
  imageUrl        String
  caption         String?
  description     String?
  destinationId   Int?
  destination     Destination? @relation(fields: [destinationId], references: [id])
}

model Service {
  id              Int       @id @default(autoincrement())
  name            String
  description     String
  price           Float
  duration        String?
  includes        String?
  destinationId   Int
  destination     Destination @relation(fields: [destinationId], references: [id])
  bookings        Booking[]
}