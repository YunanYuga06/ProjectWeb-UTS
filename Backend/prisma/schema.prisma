// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // Tambahkan baris output ini:
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  username          String    @unique
  hashedPassword    String
  salt              String?
  encryptedFullName String?
  encryptedEmail    String?
  bookings          Booking[]
  testimonials      Testimonial[]
}

model Booking {
  id                    Int       @id @default(autoincrement())
  userId                Int
  user                  User      @relation(fields: [userId], references: [id])
  tourName              String // Ini bisa diganti dengan relasi ke Service.id
  bookingDate           String
  encryptedPaymentDetails String?
  serviceId             Int?      // Opsional: Foreign Key ke Service.id
  service               Service?  @relation(fields: [serviceId], references: [id])
}

// ProjectWeb-UTS-main/Backend/prisma/schema.prisma

model Destination {
  id                Int            @id @default(autoincrement())
  name              String         @unique
  shortDescription  String
  longDescription   String
  imageUrl          String
  cardImageUrl      String
  location          String         // Contoh: "Karangsalam, Baturaden, Banyumas"
  openingHours      String?        // Contoh: "Buka setiap hari 08.00-17.00"
  contactPhone      String?        // Contoh: "0811-287-686"
  contactEmail      String?        // Tambahan: Penting untuk sistem booking
  mapEmbedUrl       String?        // URL untuk iframe peta, lebih spesifik dari detailsMapUrl sebelumnya
  basePrice         Float?         // Harga dasar tiket/masuk, gunakan Float untuk koma
  currency          String?        // Contoh: "IDR"
  priceNotes        String?        // Catatan tambahan terkait harga (misal: "Tarif per orang: Rp 25.000–50.000")
  temperatureRange  String?
  altitude          String?
  categories        String         // Contoh: "Adventure", "Culinary", "Refreshing"
  features          String?        // Fitur spesifik (misal: "Area Parkir Luas", "Akses Kursi Roda")

  galleryImages     GalleryImage[]
  services          Service[]
  testimonials      Testimonial[]

}


model Testimonial {
  id            Int         @id @default(autoincrement())
  quoteText     String
  destinationId Int?
  destination   Destination? @relation(fields: [destinationId], references: [id])
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
}


model GalleryImage {
  id              Int       @id @default(autoincrement())
  imageUrl        String
  caption         String?
  description     String?
  destinationId   Int?
  destination     Destination? @relation(fields: [destinationId], references: [id])
}

model Service {
  id              Int       @id @default(autoincrement())
  name            String
  description     String
  price           Float
  duration        String?
  includes        String?
  destinationId   Int
  destination     Destination @relation(fields: [destinationId], references: [id])
  bookings        Booking[]
}