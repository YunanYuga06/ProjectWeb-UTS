// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // Tambahkan baris output ini:
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int           @id @default(autoincrement())
  username          String        @unique
  hashedPassword    String
  salt              String?
  encryptedFullName String?
  role              String        @default("user")
  encryptedEmail    String?
  bookings          Booking[]
  testimonials      Testimonial[]
}

model Booking {
  id                      Int      @id @default(autoincrement())
  userId                  Int
  user                    User     @relation(fields: [userId], references: [id]) // Relasi ke model User
  destinationId           Int
  destination             Destination @relation(fields: [destinationId], references: [id]) // Relasi baru ke model Destination
  bookingDate             String   // Sesuai permintaan, tetap String (pertimbangkan DateTime untuk akurasi tanggal)
  paymentMethod           String   // Contoh: "Bank Transfer", "OVO", "Gopay"
  paymentProofUrl         String?
  customerTransactionNumber String? // Perhatikan: saya jadikan optional `String?` jika ada skenario tidak diisi
  status                  String   @default("pending")

  // --- Tambahan untuk memperbaiki error relasi dengan Service ---
  serviceId               Int?     // Foreign Key ke Service.id (opsional)
  service                 Service? @relation(fields: [serviceId], references: [id]) // Relasi ke model Service
  testimonial             Testimonial? 
  // --- Akhir tambahan ---
}

// ProjectWeb-UTS-main/Backend/prisma/schema.prisma

model Destination {
  id                Int            @id @default(autoincrement())
  name              String         @unique
  shortDescription  String
  longDescription   String         @db.Text
  imageUrl          String
  cardImageUrl      String
  location          String
  openingHours      String?
  contactPhone      String?
  contactEmail      String?
  mapEmbedUrl       String?
  basePrice         Float?
  currency          String?
  priceNotes        String?
  temperatureRange  String?
  altitude          String?
  categories        String
  features          String?

  galleryImages     GalleryImage[]
  services          Service[]
  testimonials      Testimonial[]
  bookings          Booking[]
}


model Testimonial {
  id            Int          @id @default(autoincrement())
  quoteText     String
  destinationId Int?
  destination   Destination? @relation(fields: [destinationId], references: [id])
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  bookingId     Int?         @unique // <--- BARU: bookingId harus unik untuk 1-to-1
  booking       Booking?     @relation(fields: [bookingId], references: [id]) // <--- BARU
}


model GalleryImage {
  id            Int          @id @default(autoincrement())
  imageUrl      String
  caption       String?
  description   String?
  destinationId Int?
  destination   Destination? @relation(fields: [destinationId], references: [id])
}

model Service {
  id            Int          @id @default(autoincrement())
  name          String
  description   String
  price         Float
  duration      String?
  includes      String?
  destinationId Int
  destination   Destination  @relation(fields: [destinationId], references: [id])
  bookings      Booking[]    // Relasi ke Booking
}